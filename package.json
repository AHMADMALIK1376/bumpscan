{
  "name": "bumpscan",
  "version": "0.1.1",
  "description": "See exactly which lines of your code an npm package upgrade will break, before you upgrade.",
  "type": "module",
  "bin": {
    "bumpscan": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "upgrade",
    "breaking-changes",
    "dependencies",
    "npm",
    "typescript",
    "semver",
    "cli",
    "dependabot"
  ],
  "author": "Muhammad Ahmad Malik",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "pacote": "^22.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pacote": "^11.1.8",
    "@types/semver": "^7.8.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AHMADMALIK1376/bumpscan.git"
  },
  "homepage": "https://github.com/AHMADMALIK1376/bumpscan#readme",
  "bugs": {
    "url": "https://github.com/AHMADMALIK1376/bumpscan/issues"
  }
}
